# Catalyst join flow. Copy these into the Vercel project settings (Environment Variables), never into git.
# Full steps: docs/onboarding-setup.md

# Discord application and bot (discord.com/developers)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# GitHub OAuth app (proves the person owns the GitHub account; no permissions are requested)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Role ids and channel ids (Discord: turn on Developer Mode, right click, Copy ID)
DISCORD_ROLE_CATALYST=
DISCORD_ROLE_PENDING=
# Optional: a hidden role so the reminder is sent once
DISCORD_ROLE_REMINDED=
# Optional: comma separated role ids that are never invited or removed (Maintainer, Core, moderators)
DISCORD_ROLES_EXEMPT=
# Private channel only the mediators can see: the form answers are posted here
DISCORD_CHANNEL_FORMS=
# Strongly recommended: a public channel where someone is pinged if their direct messages are closed.
# Without it, a person whose messages are closed cannot be reached at all (the sweep reports them as "unreachable").
DISCORD_CHANNEL_WELCOME=

# Random secrets (for example 48 random letters and digits). Lengths: at least 32, 32 and 24.
JOIN_SIGNING_SECRET=
# NEVER CHANGE after people have joined: it keys the one-way codes in the database; changing it forgets everyone.
JOIN_ID_SECRET=
# Also the password both timers (QStash and GitHub Actions) send to /api/join/sweep.
CRON_SECRET=

# The database (Upstash Redis). Vercel adds these for you when you connect the Upstash integration;
# either name pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Minimum account ages in days (empty or 0 = no minimum). Decided by Kevin on 21 Sep 2026: 7 for Discord, 30 for GitHub.
# These two values drive both the check and the rule stated in the public rules, so the two can never disagree.
# Redeploy after changing them.
NEXT_PUBLIC_JOIN_MIN_DISCORD_DAYS=7
NEXT_PUBLIC_JOIN_MIN_GITHUB_DAYS=30
# Optional server-only overrides of the check, without changing the public text: JOIN_MIN_DISCORD_DAYS, JOIN_MIN_GITHUB_DAYS
# Set to false to let people without a GitHub account join (only their Discord identity is then checked).
JOIN_REQUIRE_GITHUB=true

# Safety switches. Nobody is removed until ONBOARDING_START is set AND ONBOARDING_DRY_RUN is exactly "false".
# ONBOARDING_START is the moment you switch the system on (ISO time). People who joined before it are never touched.
ONBOARDING_START=
ONBOARDING_DRY_RUN=true
# Hours to complete the form (default 24). If you change it, also set NEXT_PUBLIC_ONBOARDING_HOURS to the same number.
ONBOARDING_HOURS=24
NEXT_PUBLIC_ONBOARDING_HOURS=24

# ---- Promotion from Catalyst to Maintainer (docs/onboarding-setup.md, "Promotion"). The join flow works without these.
# The Discord application's public key (developer portal, General Information). Proves a request really came from Discord.
DISCORD_PUBLIC_KEY=
DISCORD_ROLE_MAINTAINER=
# A private channel where Friday posts nominations and logs every promotion.
DISCORD_CHANNEL_PROMOTIONS=
# Discord user ids (comma separated) allowed to promote, demote, credit, list, and to press the nomination buttons.
PROMOTER_IDS=
# Optional tuning. A Catalyst is nominated after this many days AND this many points (2 per merged pull request in the last 60
# days, 2 per credit note in the last 90, five of each at most). GitHub organisations whose merged pull requests count.
PROMOTE_MIN_DAYS=30
PROMOTE_MIN_POINTS=8
PROMOTE_GITHUB_ORGS=helloedithstudio,Edith-Studio
# Optional: a GitHub token with NO scopes. It lifts GitHub's search limit from 10 to 30 requests a minute.
GITHUB_TOKEN=

# The go-live switch for what the public pages SAY (rules, privacy text, FAQ, home copy about the 24 hour form).
# Set to true at the same moment as ONBOARDING_DRY_RUN=false, then redeploy. Until then the site promises nothing.
NEXT_PUBLIC_JOIN_LIVE=false

# ---- "Become a Catalyst" modal form (components/catalyst/, app/api/catalyst/)
# Shown in the success screen as a "Back to Discord" button. Optional: if absent, only the Close button appears.
NEXT_PUBLIC_DISCORD_INVITE_URL=

# Storage for Catalyst registrations.
# Preferred: Supabase (writes to the existing public.catalysts table via the service role key).
# The service role key bypasses RLS — never expose it to the client or use NEXT_PUBLIC_ keys here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fallback: a dedicated Upstash Redis database.
CATALYST_STORE_URL=
CATALYST_STORE_TOKEN=
# Or reuse the existing Upstash database (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN above).
#   Keys are prefixed "catalyst:discord:<id>" so they never collide with the join-flow keys.
#   Leave CATALYST_STORE_URL empty and the API falls back to UPSTASH_REDIS_REST_URL automatically.

# Optional: Discord webhook URL. When set, a notification is posted to that channel every time
# a new Catalyst registers (name, Discord ID, GitHub, X, LinkedIn, portfolio). Keep it private.
CATALYST_WEBHOOK_URL=
